# Supabase (client-side — exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-side — Next.js API routes, cookie validation, admin ops)
SUPABASE_SERVICE_ROLE_KEY=

# Agent service auth (shared secret — must match DOMUS_SERVICE_TOKEN on Railway)
DOMUS_SERVICE_TOKEN=

# Agent service URL (SSE proxy forwards here)
DOMUS_AGENT_URL=http://localhost:8000
